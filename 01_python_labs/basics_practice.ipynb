# ==========================
# Bài 1.4 - Phân tích chỉ số cảm biến
# ==========================

temps = [23.5, 25.0, 19.8, 32.4, 28.1, 15.2, 30.0]

max_temp = temps[0]
min_temp = temps[0]
tong = 0

for temp in temps:
    if temp > max_temp:
        max_temp = temp

    if temp < min_temp:
        min_temp = temp

    tong += temp

average = tong / len(temps)

print("\nBài 1.4")
print("Nhiệt độ cao nhất:", max_temp)
print("Nhiệt độ thấp nhất:", min_temp)
print("Nhiệt độ trung bình:", average)

